<?xml version="1.0"?>
<robot name="rs003nff60">

  <!-- ==========================================================
       URDF generado EXACTAMENTE a partir de la tabla de parámetros
       Denavit-Hartenberg (foto adjunta por el usuario).

       Convención usada (coincide con el orden de columnas de la
       tabla: theta_i | d_i | alpha_i | a_i):

           A_i = Rz(theta_i) * Tz(d_i) * Rx(alpha_i) * Tx(a_i)

       Tabla DH (mm y rad):
         Link |  theta_i     |  d_i  |  alpha_i  |  a_i
           1  |  theta1      |  250  |   +pi/2   |  120
           2  |  theta2      |    0  |     0     |    0
           3  |  theta3+pi/2 |    0  |   +pi/2   |  250
           4  |  theta4      |  250  |   -pi/2   |    0
           5  |  theta5      |    0  |   +pi/2   |    0
           6  |  theta6      |   80  |     0     |    0

       Cómo se llevó cada fila de la tabla DH a un joint URDF:
       Como Rz(theta) y Tz(d) conmutan (ambas son sobre el eje z),
       el producto total de las 6 matrices DH se puede reescribir
       como: [Tz(d1)*Rz(th1)] * [Rx(a1)*Tx(a1)*Tz(d2)*Rz(th2)] * ...
       Esto permite definir, para cada joint i, un "origin" fijo
       igual a:
             origin_i = Rx(alpha_{i-1}) * Tx(a_{i-1}) * Tz(d_i)
       (con alpha_0 = a_0 = 0), eje de giro = z, y variable = theta_i.
       Esta construcción se verificó numéricamente (Python/numpy):
       para ángulos aleatorios, T_URDF = T_DH exactamente (error 0).

       El offset fijo de +pi/2 del link 3 (theta3 + pi/2 en la tabla)
       se incorpora como una rotación constante rpy_z=+pi/2 en el
       origin de joint3: así, el valor del joint en el URDF
       corresponde exactamente a theta3 tal como aparece en la tabla.

       HOME (todos los joints en 0 rad) -> posición del punto P
       (origen de tool0) respecto a la base: x=450 mm, y=0, z=500 mm.

       El origen del robot se ancla en el mundo en (0,0,0).
       ========================================================== -->

  <material name="grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================= BASE (columna fija, d1 = 250 mm) =================
       Como el eje de joint1 es z (vertical) y coincide con el eje de
       esta columna, se puede modelar toda la columna como parte del
       base_link sin afectar la cinemática (rotacionalmente simétrica). -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.25"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.25"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <origin xyz="0 0 0.125"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <!-- ================= J1: theta1, d1=250, alpha1=+90, a1=120 ================= -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9671" upper="2.9671" effort="200" velocity="6.28"/>
  </joint>

  <!-- link1: va de joint1 a joint2, offset local (0.12, 0, 0) -> 120 mm en X -->
  <link name="link1">
    <visual>
      <origin xyz="0.06 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.12"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0.06 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.12"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="6.0"/>
      <origin xyz="0.06 0 0"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- ================= J2: theta2, d2=0, alpha2=0, a2=0 ================= -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.12 0 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.0472" upper="1.5708" effort="200" velocity="5.24"/>
  </joint>

  <!-- link2: joint3 coincide con joint2 (d2=a2=0) -> solo un muñón visual -->
  <link name="link2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.07" length="0.06"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.07" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.008"/>
    </inertial>
  </link>

  <!-- ================= J3: theta3+90, d3=0, alpha3=+90, a3=250 =================
       El offset de +pi/2 de la tabla se aplica como rpy_z=+pi/2 fijo:
       el valor de este joint en el URDF = theta3 (tal cual la tabla). -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0" rpy="0 0 1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.0472" upper="1.0472" effort="150" velocity="6.28"/>
  </joint>

  <!-- link3: va de joint3 a joint4, offset local (0.25, -0.25, 0) -> 353.6 mm diagonal (a3=250, alpha3=90) -->
  <link name="link3">
    <visual>
      <origin xyz="0.125 -0.125 0" rpy="1.5708 0.7854 0.7854"/>
      <geometry>
        <cylinder radius="0.055" length="0.3536"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0.125 -0.125 0" rpy="1.5708 0.7854 0.7854"/>
      <geometry>
        <cylinder radius="0.055" length="0.3536"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <origin xyz="0.125 -0.125 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.006"/>
    </inertial>
  </link>

  <!-- ================= J4: theta4, d4=250, alpha4=-90, a4=0 ================= -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.25 -0.25 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.4907" upper="3.4907" effort="50" velocity="9.42"/>
  </joint>

  <!-- link4: joint5 coincide con joint4 (d4 ya viaja dentro del origin de joint4) -->
  <link name="link4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.08"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ================= J5: theta5, d5=0, alpha5=+90, a5=0 ================= -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.1817" upper="2.1817" effort="50" velocity="9.42"/>
  </joint>

  <!-- link5: va de joint5 a joint6, offset local (0, -0.08, 0) -> 80 mm (d6) -->
  <link name="link5">
    <visual>
      <origin xyz="0 -0.04 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.08"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 -0.04 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 -0.04 0"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0006"/>
    </inertial>
  </link>

  <!-- ================= J6: theta6, d6=80, alpha6=0, a6=0 ================= -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="flange"/>
    <origin xyz="0 -0.08 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="30" velocity="12.56"/>
  </joint>

  <link name="flange">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.02"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0.01"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Punto P: como a6=0 y alpha6=0, tool0 coincide EXACTAMENTE con
       el frame 6 de la tabla DH (sin offsets inventados). -->
  <joint name="flange_to_tool0" type="fixed">
    <parent link="flange"/>
    <child link="tool0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tool0"/>

</robot>
