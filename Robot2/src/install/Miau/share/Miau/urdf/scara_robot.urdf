<?xml version="1.0"?>
<!--
  URDF de robot SCARA basado en el plano de especificaciones proporcionado.
  Origen del robot: (0, 0, 0) en la base, sobre la superficie de montaje.

  Mapeo de cotas del plano -> parámetros del modelo:
    - 200 mm (horizontal, x2)  -> longitud de link1 (J1->J2) y link2 (J2->J3) = 0.20 m c/u
    - 200 mm (base->hombro)   -> altura de base_link hasta el plano de J1/J2 = 0.20 m
    - 150 mm                  -> AJUSTE A PEDIDO DEL USUARIO: posición de la herramienta
                                  en el ORIGEN de J3 (q=0), z=0.15 m (no al ras del
                                  hombro). Se logra con un offset fijo z=-0.05 m en el
                                  origin de la junta J3 (0.20 - 0.05 = 0.15).
    - 200 mm (stroke)          -> AJUSTE A PEDIDO DEL USUARIO: recorrido de J3 = 0.20 m
                                  hacia abajo desde el origen (z=0.15), por lo que el
                                  límite superior de J3 pasa de 0.15 a 0.20 m. En el
                                  extremo del recorrido la herramienta queda en
                                  z = 0.15 - 0.20 = -0.05 m (por debajo del plano de
                                  la base): se acepta así explícitamente, aunque salga
                                  del volumen físico de la base tal como está modelada.
    - 558 mm ("Stroke of J3 axis")    -> altura total de envolvente en J3=0 (base ->
                                          tope de columna/vástago). La columna amarilla
                                          se reajustó (offset local 0.229 en vez de
                                          0.179) para seguir llegando a z=0.558 m en
                                          J3=0 pese al nuevo offset de la junta J3.

  SUPUESTOS (el plano no los acota, se agregan por ser estándar en un SCARA):
    - J1: revoluta, límite ±150° (ajustar según el modelo real)
    - J2: revoluta, límite ±150°
    - J3: prismática, recorrido de 0.15 m (arriba, origen) a -0.05 m (abajo, ver ajuste)
    - J4: revoluta de muñeca (rotación de herramienta), continua, no acotada en el plano
-->
<robot name="scara_robot">

  <material name="grey">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>
  <material name="yellow">
    <color rgba="0.9 0.8 0.1 1.0"/>
  </material>

  <!-- ================= BASE ================= -->
  <!-- Fija al mundo en (0,0,0). Altura de base = 0.20 m (cota "200" exterior) -->
  <link name="world"/>

  <joint name="base_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.14 0.20"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.14 0.20"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <!-- ================= LINK 1 (J1 -> J2), 0.20 m ================= -->
  <joint name="J1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <!-- top de la base = 0.20 m, coincide con cota "200" -->
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.618" upper="2.618" effort="50" velocity="3.0"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.08 0.08"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.08 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- ================= LINK 2 (J2 -> J3), 0.20 m ================= -->
  <joint name="J2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.20 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.618" upper="2.618" effort="30" velocity="3.0"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.07 0.07"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.07 0.07"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/>
    </inertial>
  </link>

  <!-- ================= J3: PRISMÁTICA, origen z=0.15 m, stroke 0.2 m =================
       Ajuste según confirmación del usuario: en J3=0 (origen) la herramienta debe
       quedar en z=0.15 m (no en el plano de hombro z=0.20 m), por eso el origin de
       esta junta lleva el offset fijo z=-0.05 m (0.20 - 0.05 = 0.15). Desde ahí el
       stroke es de 0.2 m hacia abajo, así que el límite superior pasa de 0.15 a 0.20 m.
       Con esto, en el extremo del recorrido la herramienta llega a z=0.15-0.20=-0.05 m
       (por debajo del plano de la base): se acepta así a pedido explícito del usuario,
       aunque quede fuera del volumen físico de la base tal como está modelada. -->
  <joint name="J3" type="prismatic">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.20 0 -0.05" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="0.20" effort="40" velocity="0.5"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.10"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Columna amarilla (referencia visual, cota "558"), solidaria con link3.
         Como ahora el marco de link3 en J3=0 está en z=0.15 (no 0.20), se sube el
         offset local a 0.229 (antes 0.179) para que el tope siga en z=0.15+0.229+0.179
         = 0.558 m cuando J3=0, igual que antes. -->
    <visual>
      <origin xyz="0 0 0.229" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.358"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- ================= J4: revoluta de muñeca (SUPUESTO, no acotada en el plano) =================
       CORRECCIÓN: antes había un offset fijo de -0.15 m aquí, ADEMÁS del recorrido
       propio de J3. Eso duplicaba el stroke de 150 mm y hacía que, con J3 al máximo,
       la herramienta quedara en -0.10 m (¡por debajo de la base, imposible!).
       Según el plano, la cota "150" ya es el recorrido completo desde la posición
       superior (herramienta a 200 mm de la base) hasta la inferior (50 mm), así que
       la brida va sin offset extra: coincide con la punta del vástago que mueve J3. -->
  <joint name="J4" type="revolute">
    <parent link="link3"/>
    <child link="tool_flange"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283" upper="6.283" effort="5" velocity="5.0"/>
  </joint>

  <link name="tool_flange">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.01"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

</robot>
