<?xml version="1.0"?>
<robot name="manipulador_dh_3dof">

  <!-- ===================== Colores ===================== -->
  <material name="blue"><color rgba="0.2 0.2 0.8 1"/></material>
  <material name="red"><color rgba="0.8 0.2 0.2 1"/></material>
  <material name="green"><color rgba="0.2 0.8 0.2 1"/></material>
  <material name="yellow"><color rgba="0.8 0.8 0.2 1"/></material>
  <material name="grey"><color rgba="0.3 0.3 0.3 1"/></material>

  <!-- ===================== Mundo ===================== -->
  <link name="world"/>

  <!-- =========================================================
       FILA 1 DH: theta1 (variable), d1=0.10, a1=0, alpha1=90°
       joint1 = base, rota sobre Z, sube d1=10cm
       ========================================================= -->
  <joint name="joint1_base" type="revolute">
    <parent link="world"/>
    <child link="link1"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10" velocity="1"/>
  </joint>

  <link name="link1">
    <!-- Columna de base: cuelga desde el origen del link (altura 10cm) hasta el suelo -->
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.10"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <!-- Marca roja para verificar visualmente la rotación de theta1 -->
    <visual>
      <origin xyz="0.045 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.015 0.015"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <!-- =========================================================
       FILA 2 DH: theta2+90° (variable), d2=0, a2=0.20, alpha2=0
       El +90° y el twist alpha1=90° (heredado de la fila 1) se
       incorporan en el origen fijo de este joint.
       ========================================================= -->
  <joint name="joint2_shoulder" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0" rpy="1.5707963 -1.5707963 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10" velocity="1"/>
  </joint>

  <link name="link2">
    <!-- Eslabón de 20cm (a2) -->
    <visual>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.04 0.04"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <!-- =========================================================
       FILA 3 DH: theta3-90° (variable), d3=0, a3=0.20, alpha3=0
       El -90° y a2=0.20 (heredado de la fila 2) se incorporan
       en el origen fijo de este joint.
       ========================================================= -->
  <joint name="joint3_elbow" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.20 0 0" rpy="0 0 -1.5707963"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10" velocity="1"/>
  </joint>

  <link name="link3">
    <!-- Eslabón de 20cm (a3) -->
    <visual>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.04 0.04"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <!-- =========================================================
       FILA 4 DH: theta4=0 (constante), d4=0, a4=0.05, alpha4=0
       Sin variable -> junta FIJA (montaje de herramienta).
       a3=0.20 (heredado de la fila 3) se incorpora en el origen.
       ========================================================= -->
  <joint name="joint4_tool_mount" type="fixed">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.20 0 0" rpy="0 0 0"/>
  </joint>

  <link name="link4">
    <!-- Herramienta fija de 5cm (a4) -->
    <visual>
      <origin xyz="0.025 0 0" rpy="0 1.5707963 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.05"/>
      </geometry>
      <material name="yellow"/>
    </visual>
  </link>

  <!-- =========================================================
       LINK DEL EFECTOR FINAL (punta de la herramienta)
       Ubicado en la punta de link4 (extremo de los 5cm, a4).
       No aporta geometría al DH, es solo un frame + marcador
       visual para poder ver el punto TCP (Tool Center Point)
       y leer sus coordenadas en RViz.
       ========================================================= -->
  <joint name="joint5_end_effector" type="fixed">
    <parent link="link4"/>
    <child link="end_effector"/>
    <origin xyz="0.05 0 0" rpy="0 0 0"/>
  </joint>

  <link name="end_effector">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

</robot>
