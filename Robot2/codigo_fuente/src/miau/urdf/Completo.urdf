     For more information, please see http://wiki.ros.org/sw_urdf_exporter -->
<robot
  name="Completo">

  <!-- Link fijo al mundo: ancla el robot para que no caiga/voltee por gravedad -->
  <link name="world" />

  <joint
    name="world_to_base"
    type="fixed">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent
      link="world" />
    <child
      link="base_link" />
  </joint>

  <link
    name="base_link">
    <inertial>
      <origin
        xyz="0.20463 0.17057 0.069727"
        rpy="0 0 0" />
      <mass
        value="3.1919" />
      <inertia
        ixx="0.017016"
        ixy="1.8901E-06"
        ixz="-0.002508"
        iyy="0.017623"
        iyz="-0.0025204"
        izz="0.024307" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 -0.01"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://miau/meshes/base_link.STL" />
      </geometry>
      <material
        name="gengar_purpura_oscuro">
        <color
          rgba="0.29 0.15 0.42 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 -0.01"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://miau/meshes/base_link.STL" />
      </geometry>
    </collision>

    <!-- ===================== Rostro (imagen PNG aplicada como textura) ===================== -->
    <visual>
      <origin xyz="-0.02 -0.095 0.08" rpy="0 0 0" />
      <geometry>
        <box size="0.14 0.004 0.13" />
      </geometry>
      <material name="gengar_rostro_textura">
        <texture filename="package://miau/meshes/textures/cara.png" />
      </material>
    </visual>
  </link>

  <link
    name="L1">
    <inertial>
      <origin
        xyz="-0.00011021 -0.0034718 0.18954"
        rpy="0 0 3.1416" />
      <mass
        value="1.2503" />
      <inertia
        ixx="0.0039841"
        ixy="2.4766E-06"
        ixz="3.1699E-06"
        iyy="0.003996"
        iyz="2.0743E-05"
        izz="0.0053377" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 3.1416" />
      <geometry>
        <mesh
          filename="package://miau/meshes/L1.STL" />
      </geometry>
      <material
        name="gengar_morado">
        <color
          rgba="0.42 0.22 0.58 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 3.1416" />
      <geometry>
        <mesh
          filename="package://miau/meshes/L1.STL" />
      </geometry>
    </collision>
  </link>

  <joint
    name="J1"
    type="continuous">
    <origin
      xyz="0 0 0"
      rpy="0 0 3.1416" />
    <parent
      link="base_link" />
    <child
      link="L1" />
    <axis
      xyz="0 0 1" />
    <dynamics
      damping="0.1"
      friction="0.05" />
    <limit
      effort="50"
      velocity="3.0" />
  </joint>

  <link
    name="L2">
    <inertial>
      <origin
        xyz="0.096796 -1.9368E-08 0.069802"
        rpy="0 0 0" />
      <mass
        value="0.61222" />
      <inertia
        ixx="0.00072999"
        ixy="1.4858E-09"
        ixz="1.6773E-05"
        iyy="0.0052856"
        iyz="-3.9102E-10"
        izz="0.0053029" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://miau/meshes/L2.STL" />
      </geometry>
      <material
        name="gengar_orquidea">
        <color
          rgba="0.58 0.35 0.75 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://miau/meshes/L2.STL" />
      </geometry>
    </collision>
  </link>

  <joint
    name="J2"
    type="continuous">
    <origin
      xyz="-3.5078E-05 0.05 0.31568"
      rpy="1.5708 0 3.1416" />
    <parent
      link="L1" />
    <child
      link="L2" />
    <axis
      xyz="0 0 1" />
    <dynamics
      damping="0.1"
      friction="0.05" />
    <limit
      effort="50"
      velocity="3.0" />
  </joint>

  <link
    name="L3">
    <inertial>
      <origin
        xyz="0.074686 -0.0014245 0.0971"
        rpy="0 0 0" />
      <mass
        value="0.43367" />
      <inertia
        ixx="0.00046332"
        ixy="3.765E-05"
        ixz="-6.2733E-08"
        iyy="0.0015707"
        iyz="-4.5092E-08"
        izz="0.0015747" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://miau/meshes/L3.STL" />
      </geometry>
      <material
        name="gengar_lavanda">
        <color
          rgba="0.72 0.5 0.85 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://miau/meshes/L3.STL" />
      </geometry>
    </collision>
  </link>

  <joint
    name="J3"
    type="continuous">
    <origin
      xyz="0.20193 0 0.097"
      rpy="-3.1416 0 1.5708" />
    <parent
      link="L2" />
    <child
      link="L3" />
    <axis
      xyz="0 0 1" />
    <dynamics
      damping="0.1"
      friction="0.05" />
    <limit
      effort="50"
      velocity="3.0" />
  </joint>

  <!-- Link/joint del efector final: coincide con tip_link="tcp" usado en el nodo IK -->
  <link
    name="tcp">
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <sphere
          radius="0.015" />
      </geometry>
      <material
        name="gengar_rojo">
        <color
          rgba="0.82 0.1 0.25 1" />
      </material>
    </visual>
  </link>

  <joint
    name="J_tcp"
    type="fixed">
    <origin
      xyz="0.27387 -0.00957 0.0975"
      rpy="0 0 0" />
    <parent
      link="L3" />
    <child
      link="tcp" />
    <axis
      xyz="0 0 0" />
  </joint>

  <!-- ===================== ros2_control (para Gazebo) ===================== -->
  <ros2_control
    name="GazeboSystem"
    type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="J1">
      <command_interface name="position">
        <param name="min">-3.1416</param>
        <param name="max">3.1416</param>
      </command_interface>
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="J2">
      <command_interface name="position">
        <param name="min">-3.1416</param>
        <param name="max">3.1416</param>
      </command_interface>
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="J3">
      <command_interface name="position">
        <param name="min">-3.1416</param>
        <param name="max">3.1416</param>
      </command_interface>
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </ros2_control>

  <gazebo>
    <plugin
      filename="gz_ros2_control-system"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find miau)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ===================== Materiales / fricción para Gazebo ===================== -->
  <gazebo reference="base_link">
    <material>
      <ambient>0.29 0.15 0.42 1</ambient>
      <diffuse>0.29 0.15 0.42 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="L1">
    <material>
      <ambient>0.42 0.22 0.58 1</ambient>
      <diffuse>0.42 0.22 0.58 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="L2">
    <material>
      <ambient>0.58 0.35 0.75 1</ambient>
      <diffuse>0.58 0.35 0.75 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="L3">
    <material>
      <ambient>0.72 0.5 0.85 1</ambient>
      <diffuse>0.72 0.5 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="tcp">
    <material>
      <ambient>0.82 0.1 0.25 1</ambient>
      <diffuse>0.82 0.1 0.25 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </material>
  </gazebo>

  <!-- ===================== Caja obstáculo independiente (10x10x5 cm = 0.10x0.10x0.05 m), centrada en (3, -19, 10) cm = (0.03, -0.19, 0.10) m ===================== -->
  <link name="caja_obstaculo">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.10 0.10 0.05" />
      </geometry>
      <material name="caja_gris">
        <color rgba="0.6 0.6 0.6 0.7" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.10 0.10 0.05" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>

  <joint name="world_to_caja_obstaculo" type="fixed">
    <origin xyz="0.03 -0.19 0.10" rpy="0 0 0" />
    <parent link="world" />
    <child link="caja_obstaculo" />
  </joint>

</robot>