<?xml version="1.0" encoding="utf-8"?>
<!-- URDF del robot Ensamblaje1 con Mesa Independiente de 4 Patas y Cajas -->
<robot name="Ensamblaje1">

  <!-- ==================== BASE DEL ROBOT ==================== -->
  <link name="baase">
    <inertial>
      <origin xyz="0 -9.99200722162641E-16 0.0835836782968658" rpy="0 0 0" />
      <mass value="2.65621658861017" />
      <inertia ixx="0.0155663062259803" ixy="7.84571457849969E-34" ixz="3.05521559154925E-18" iyy="0.0155663062259803" iyz="8.85843584594874E-17" izz="0.00718660917958159" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/baase.STL" />
      </geometry>
      <material name="robot_color">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/baase.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== ROTACIÓN 1 ==================== -->
  <link name="rot1">
    <inertial>
      <origin xyz="0.121288002243017 -0.00292197970260716 0.0296690863987195" rpy="0 0 0" />
      <mass value="1.05132741228718" />
      <inertia ixx="0.000968741777605741" ixy="8.51098705401121E-18" ixz="-0.000399196555067436" iyy="0.00620864004558682" iyz="3.24064416234824E-18" izz="0.00629429353114416" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/rot1.STL" />
      </geometry>
      <material name="robot_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/rot1.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="rot1" type="continuous">
    <origin xyz="-0.00374100102465513 -0.00116774447773682 0.199999999999928" rpy="0 0 1.14398267981626" />
    <parent link="baase" />
    <child link="rot1" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- ==================== ROTACIÓN 2 ==================== -->
  <link name="rot2">
    <inertial>
      <origin xyz="0.112061814783659 0.00333281197033952 0.0250000000000717" rpy="0 0 0" />
      <mass value="0.934977871437821" />
      <inertia ixx="0.000733971739040041" ixy="1.89735380184963E-19" ixz="7.2974123484672E-19" iyy="0.00541787065010435" iyz="-3.25797801511376E-19" izz="0.0057622682760453" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/rot2.STL" />
      </geometry>
      <material name="robot_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/rot2.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="rot2" type="continuous">
    <origin xyz="0.199999999999999 0 0.0500000000000022" rpy="0 0 -1.85820160252122" />
    <parent link="rot1" />
    <child link="rot2" />
    <axis xyz="0 0 -1" />
  </joint>

  <!-- ==================== PRISMÁTICA (SUBE/BAJA) ==================== -->
  <link name="pris">
    <inertial>
      <origin xyz="0.00349664767441131 0.00176979401987554 0.0667401873011129" rpy="0 0 0" />
      <mass value="1.00399485275591" />
      <inertia ixx="0.0107968199035862" ixy="0" ixz="-2.96646160758765E-19" iyy="0.0107968199035862" iyz="-1.74955112067356E-18" izz="0.000376409714805212" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/pris.STL" />
      </geometry>
      <material name="robot_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/pris.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="pris" type="prismatic">
    <origin xyz="0.22 0 0" rpy="0 0 0.54823" />
    <parent link="rot2" />
    <child link="pris" />
    <axis xyz="0 0 1" />
    <limit lower="-0.0913" upper="0.13892" effort="100.0" velocity="1.0" />
  </joint>

  <!-- =============================================================== -->
  <!--                ENTORNO: MESA CON 4 PATAS Y CAJAS                -->
  <!-- =============================================================== -->

  <!-- MATERIALES -->
  <material name="madera_oscura">
    <color rgba="0.45 0.25 0.10 1.0"/>
  </material>

  <material name="patas_metal">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <material name="caja_carton">
    <color rgba="0.85 0.55 0.20 1.0"/>
  </material>

  <material name="caja_azul">
    <color rgba="0.2 0.5 0.8 1.0"/>
  </material>

  <!-- 1. TABLERO DE LA MESA -->
  <link name="mesa_tablero">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Superficie: 35cm x 25cm x 2cm de espesor -->
        <box size="0.35 0.25 0.02"/>
      </geometry>
      <material name="madera_oscura"/>
    </visual>
    <!-- Patas de la mesa modeladas en el visual -->
    <!-- Pata 1 (Frontal Izquierda) -->
    <visual>
      <origin xyz="0.15 0.10 -0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.14"/>
      </geometry>
      <material name="patas_metal"/>
    </visual>
    <!-- Pata 2 (Frontal Derecha) -->
    <visual>
      <origin xyz="0.15 -0.10 -0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.14"/>
      </geometry>
      <material name="patas_metal"/>
    </visual>
    <!-- Pata 3 (Trasera Izquierda) -->
    <visual>
      <origin xyz="-0.15 0.10 -0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.14"/>
      </geometry>
      <material name="patas_metal"/>
    </visual>
    <!-- Pata 4 (Trasera Derecha) -->
    <visual>
      <origin xyz="-0.15 -0.10 -0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.14"/>
      </geometry>
      <material name="patas_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.25 0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint para fijar la mesa respecto a la base del robot (Ubicada al frente a X = 0.35m) -->
  <joint name="baase_to_mesa" type="fixed">
    <origin xyz="0.35 0 0.15" rpy="0 0 0"/>
    <parent link="baase"/>
    <child link="mesa_tablero"/>
  </joint>

  <!-- 2. CAJA 1 (Cartón - Ubicada sobre la mesa) -->
  <link name="caja1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Cubo de 6cm x 6cm x 6cm -->
        <box size="0.06 0.06 0.06"/>
      </geometry>
      <material name="caja_carton"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.06"/>
      </geometry>
    </collision>
  </link>

  <joint name="mesa_to_caja1" type="fixed">
    <origin xyz="0.05 -0.05 0.04" rpy="0 0 0"/>
    <parent link="mesa_tablero"/>
    <child link="caja1_link"/>
  </joint>

  <!-- 3. CAJA 2 (Azul - Ubicada sobre la mesa) -->
  <link name="caja2_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Caja rectangular de 8cm x 6cm x 5cm -->
        <box size="0.08 0.06 0.05"/>
      </geometry>
      <material name="caja_azul"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.06 0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="mesa_to_caja2" type="fixed">
    <origin xyz="-0.04 0.04 0.035" rpy="0 0 0"/>
    <parent link="mesa_tablero"/>
    <child link="caja2_link"/>
  </joint>

</robot>