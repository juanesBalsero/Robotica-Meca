<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="empty">
    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>5 5</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>5 5</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Estación 1: posición fija del plano, relativa a Rob3. -->
    <model name="estacion_recogida">
      <static>true</static>
      <pose>-0.19 0 0 0 0 0</pose>
      <link name="mesa">
        <visual name="tablero">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.02</size></box></geometry>
          <material>
            <ambient>0.75 0.22 0.08 1</ambient>
            <diffuse>0.90 0.30 0.10 1</diffuse>
          </material>
        </visual>
        <visual name="pata_1">
          <pose>0.055 0.055 0.04 0 0 0</pose>
          <geometry><box><size>0.02 0.02 0.08</size></box></geometry>
          <material><ambient>0.35 0.10 0.04 1</ambient><diffuse>0.50 0.14 0.05 1</diffuse></material>
        </visual>
        <visual name="pata_2">
          <pose>0.055 -0.055 0.04 0 0 0</pose>
          <geometry><box><size>0.02 0.02 0.08</size></box></geometry>
          <material><ambient>0.35 0.10 0.04 1</ambient><diffuse>0.50 0.14 0.05 1</diffuse></material>
        </visual>
        <visual name="pata_3">
          <pose>-0.055 0.055 0.04 0 0 0</pose>
          <geometry><box><size>0.02 0.02 0.08</size></box></geometry>
          <material><ambient>0.35 0.10 0.04 1</ambient><diffuse>0.50 0.14 0.05 1</diffuse></material>
        </visual>
        <visual name="pata_4">
          <pose>-0.055 -0.055 0.04 0 0 0</pose>
          <geometry><box><size>0.02 0.02 0.08</size></box></geometry>
          <material><ambient>0.35 0.10 0.04 1</ambient><diffuse>0.50 0.14 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Estación 2: posición fija del plano, relativa a Rob3. -->
    <model name="estacion_entrega">
      <static>true</static>
      <pose>0.18 0 0 0 0 0</pose>
      <link name="mesa">
        <visual name="tablero">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.02</size></box></geometry>
          <material>
            <ambient>0.05 0.35 0.55 1</ambient>
            <diffuse>0.08 0.55 0.85 1</diffuse>
          </material>
        </visual>
        <visual name="pata_1">
          <pose>0.055 0.055 0.04 0 0 0</pose>
          <geometry><box><size>0.02 0.02 0.08</size></box></geometry>
          <material><ambient>0.03 0.16 0.26 1</ambient><diffuse>0.04 0.25 0.40 1</diffuse></material>
        </visual>
        <visual name="pata_2">
          <pose>0.055 -0.055 0.04 0 0 0</pose>
          <geometry><box><size>0.02 0.02 0.08</size></box></geometry>
          <material><ambient>0.03 0.16 0.26 1</ambient><diffuse>0.04 0.25 0.40 1</diffuse></material>
        </visual>
        <visual name="pata_3">
          <pose>-0.055 0.055 0.04 0 0 0</pose>
          <geometry><box><size>0.02 0.02 0.08</size></box></geometry>
          <material><ambient>0.03 0.16 0.26 1</ambient><diffuse>0.04 0.25 0.40 1</diffuse></material>
        </visual>
        <visual name="pata_4">
          <pose>-0.055 -0.055 0.04 0 0 0</pose>
          <geometry><box><size>0.02 0.02 0.08</size></box></geometry>
          <material><ambient>0.03 0.16 0.26 1</ambient><diffuse>0.04 0.25 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
