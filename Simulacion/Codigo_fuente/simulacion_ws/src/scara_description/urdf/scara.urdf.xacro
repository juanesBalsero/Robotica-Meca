<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scara">
  <!-- SCARA R-R-P. CAD Y-up converted to ROS/Gazebo Z-up. -->

  <link name="world"/>
  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://scara_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="grey"><color rgba="0.65 0.65 0.68 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://scara_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.000000 0.000000 0.149000" rpy="0 0 0"/>
      <mass value="12.0000"/>
      <inertia ixx="0.15434000" ixy="0" ixz="0" iyy="0.15434000" iyz="0" izz="0.13107200"/>
    </inertial>
  </link>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://scara_description/meshes/link_1.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="grey"><color rgba="0.65 0.65 0.68 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://scara_description/meshes/link_1.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.079945 0.000000 0.014500" rpy="0 0 0"/>
      <mass value="2.5000"/>
      <inertia ixx="0.00744354" ixy="0" ixz="0" iyy="0.02063577" iyz="0" izz="0.02135890"/>
    </inertial>
  </link>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://scara_description/meshes/link_2.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="grey"><color rgba="0.65 0.65 0.68 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://scara_description/meshes/link_2.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.095000 -0.015000 0.043890" rpy="0 0 0"/>
      <mass value="3.0000"/>
      <inertia ixx="0.04915162" ixy="0" ixz="0" iyy="0.06595162" iyz="0" izz="0.02525000"/>
    </inertial>
  </link>

  <link name="link_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://scara_description/meshes/link_3.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="grey"><color rgba="0.65 0.65 0.68 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://scara_description/meshes/link_3.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.025385 0.000000 0.009390" rpy="0 0 0"/>
      <mass value="0.8000"/>
      <inertia ixx="0.01199003" ixy="0" ixz="0" iyy="0.01219620" iyz="0" izz="0.00022536"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0.000000 0.000000 0.303000" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="25" velocity="1.5"/>
    <dynamics damping="0.15" friction="0.02"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0.150000 0.000000 0.083000" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- Limite J2 medido por el usuario para evitar auto-colision: +/-1.750 rad = +/-100.27 deg. -->
    <limit lower="-1.750" upper="1.750" effort="20" velocity="1.5"/>
    <dynamics damping="0.15" friction="0.02"/>
  </joint>

  <joint name="joint_3" type="prismatic">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.146170 0.006000 0.034500" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.084" upper="0.084" effort="150" velocity="0.15"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <!-- ros2_control para Gazebo Harmonic / ROS 2 Jazzy -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="joint_1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint_3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <ros>
       <namespace>scara_description</namespace>
       <remapping>robot_description:=/scara_description/robot_description</remapping>
      </ros>
      <parameters>$(find scara_description)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Habilita auto-colision. Los limites articulares siguen siendo la proteccion principal. -->
  <gazebo reference="base_link"><selfCollide>true</selfCollide></gazebo>
  <gazebo reference="link_1"><selfCollide>true</selfCollide></gazebo>
  <gazebo reference="link_2"><selfCollide>true</selfCollide></gazebo>
  <gazebo reference="link_3"><selfCollide>true</selfCollide></gazebo>
</robot>
